#include <iostream>
#include <string>
#include <vector>
#include <algorithm>

int lengthOfLongestSubstring(std::string s) {
    // Array to store the last seen index of each ASCII character.
    // Initialized to -1 to indicate the character hasn't been seen yet.
    std::vector<int> charIndex(128, -1);
    
    int maxLength = 0;
    int left = 0; // Left boundary of our sliding window
    
    for (int right = 0; right < s.length(); ++right) {
        char currentChar = s[right];
        
        // If we've seen this character before AND its last seen position 
        // is inside our current window, we have a duplicate.
        if (charIndex[currentChar] >= left) {
            // Instantly jump the left pointer to the right of the duplicate
            left = charIndex[currentChar] + 1;
        }
        
        // Update the last seen index of the current character
        charIndex[currentChar] = right;
        
        // Calculate the max length found so far
        maxLength = std::max(maxLength, right - left + 1);
    }
    
    return maxLength;
}
