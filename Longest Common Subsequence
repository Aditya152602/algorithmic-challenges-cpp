#include <iostream>
#include <string>
#include <vector>
#include <algorithm>

int longestCommonSubsequence(std::string text1, std::string text2) {
    int m = text1.length();
    int n = text2.length();
    
    // Create a 2D DP table initialized to 0
    // We use size m+1 and n+1 to handle the base cases (empty substrings)
    std::vector<std::vector<int>> dp(m + 1, std::vector<int>(n + 1, 0));
    
    // Iterate through both strings
    for (int i = 1; i <= m; ++i) {
        for (int j = 1; j <= n; ++j) {
            
            // If the characters match
            if (text1[i - 1] == text2[j - 1]) {
                // Add 1 to the diagonal value (previous state without these chars)
                dp[i][j] = dp[i - 1][j - 1] + 1;
            } 
            // If they don't match
            else {
                // Take the max of either excluding current char of text1 or text2
                dp[i][j] = std::max(dp[i - 1][j], dp[i][j - 1]);
            }
        }
    }
    
    // The bottom-right cell contains the length of the LCS for the full strings
    return dp[m][n];
}
