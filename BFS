#include <iostream>
#include <vector>
#include <queue>
using namespace std;

vector<int> bfs(vector<vector<int>>& graph, int start)
{
    int n = graph.size();
    vector<int> visited(n, false);
    vector<int> result;
    queue<int> q;

    visited[start] = true;
    q.push(start);

    while (!q.empty())
    {
        int node = q.front();
        q.pop();

        result.push_back(node);

        for (int neighbor : graph[node])
        {
            if (!visited[neighbor])
            {
                visited[neighbor] = true;
                q.push(neighbor);
            }
        }
    }

    return result;
}

int main()
{
    vector<vector<int>> graph =
    {
        {1, 2},
        {0, 3, 4},
        {0, 4},
        {1},
        {1, 2}
    };

    vector<int> result = bfs(graph, 0);

    cout << "BFS: ";

    for (int x : result)
        cout << x << " ";

    return 0;
}
