#include <iostream>
#include <vector>
#include <queue>
using namespace std;

vector<int> topologicalSort(
    int n,
    vector<vector<int>>& edges)
{
    vector<vector<int>> graph(n);
    vector<int> indegree(n, 0);

    for (auto edge : edges)
    {
        int u = edge[0];
        int v = edge[1];

        graph[u].push_back(v);
        indegree[v]++;
    }

    queue<int> q;

    for (int i = 0; i < n; i++)
    {
        if (indegree[i] == 0)
            q.push(i);
    }

    vector<int> result;

    while (!q.empty())
    {
        int node = q.front();
        q.pop();

        result.push_back(node);

        for (int next : graph[node])
        {
            indegree[next]--;

            if (indegree[next] == 0)
                q.push(next);
        }
    }

    return result;
}

int main()
{
    int n = 6;

    vector<vector<int>> edges =
    {
        {5, 2},
        {5, 0},
        {4, 0},
        {4, 1},
        {2, 3},
        {3, 1}
    };

    vector<int> result = topologicalSort(n, edges);

    cout << "Topological Order: ";

    for (int x : result)
        cout << x << " ";

    return 0;
}
