#include <iostream>
#include <vector>

int uniquePaths(int m, int n) {
    // Create an m x n 2D vector initialized with 1s.
    // This brilliantly handles our base cases automatically.
    std::vector<std::vector<int>> dp(m, std::vector<int>(n, 1));
    
    // Start iterating from row 1 and col 1 (skipping base cases)
    for (int i = 1; i < m; ++i) {
        for (int j = 1; j < n; ++j) {
            
            // Paths to current cell = Paths from above + Paths from left
            dp[i][j] = dp[i - 1][j] + dp[i][j - 1];
            
        }
    }
    
    // The bottom-right cell contains the total number of unique paths
    return dp[m - 1][n - 1];
}
