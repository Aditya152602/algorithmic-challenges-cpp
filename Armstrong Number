#include<iostream>
#include<cmath>
using namespace std;

bool armstrong(int n)
{
    int original=n;
    int digits=0;

    int temp=n;

    while(temp)
    {
        digits++;
        temp/=10;
    }

    temp=n;
    int sum=0;

    while(temp)
    {
        sum+=pow(temp%10,digits);
        temp/=10;
    }

    return sum==original;
}

int main()
{
    cout<<armstrong(153);
}
